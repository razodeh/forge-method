# specs/02 §2.1: pnpm's strict node_modules is deliberate — a package that imports something it did
# not declare must fail here, not in a consumer's install.
strict-peer-dependencies=true

# Enforces the dev-toolchain Node floor in package.json (>= 20.19; see SPEC-QUESTIONS.md Q9 for why
# it differs from the >= 20.10 runtime floor specs/02 §2.1 sets for published packages). Without this,
# `engines` is advisory and a contributor on an older Node installs cleanly and fails obscurely later.
engine-strict=true
