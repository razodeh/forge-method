    "skills": {
      "additionalProperties": false,
      "properties": {
        "hardBodyCapTokens": {
          "exclusiveMinimum": 0,
          "type": "integer"
        },
        "packBudgetTokens": {
          "exclusiveMinimum": 0,
          "type": "integer"
        }
      },
      "required": [
        "packBudgetTokens",
        "hardBodyCapTokens"
      ],
      "type": "object"
    },
    "telemetry": {
      "additionalProperties": false,
      "properties": {
        "network": {
          "type": "boolean"
        },
        "otlpEndpoint": {
          "anyOf": [
            {
              "minLength": 1,
              "type": "string"
            },
            {
              "type": "null"
            }
          ]
        }
      },
      "required": [
        "network",
        "otlpEndpoint"
      ],
      "type": "object"
    },
    "vcs": {
      "additionalProperties": false,
      "properties": {
        "allowCommits": {
          "type": "boolean"
        },
        "commitConvention": {
          "minLength": 1,
          "type": "string"
        },
        "signCommits": {
          "type": "boolean"
        },
        "trailers": {
          "type": "boolean"
        }
      },
      "required": [
        "allowCommits",
        "commitConvention",
        "signCommits",
        "trailers"
      ],
      "type": "object"
    },
    "version": {
      "exclusiveMinimum": 0,
      "type": "integer"
    }
  },
  "required": [
    "version",
    "project",
    "paths",
    "platform",
    "models",
    "execution",
    "budget",
    "roster",
    "kb",
    "skills",
    "mcp",
    "diagrams",
    "quality",
    "security",
    "vcs",
    "telemetry",
    "output"
  ],
  "type": "object"
}
