{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "additionalProperties": false,
  "properties": {
    "author": {
      "minLength": 1,
      "type": "string"
    },
    "changelog": {
      "items": {
        "additionalProperties": false,
        "properties": {
          "by": {
            "minLength": 1,
            "type": "string"
          },
          "date": {
            "format": "date",
            "type": "string"
          },
          "revision": {
            "exclusiveMinimum": 0,
            "type": "integer"
          },
          "summary": {
            "minLength": 1,
            "type": "string"
          }
        },
        "required": [
          "revision",
          "date",
          "by",
          "summary"
        ],
        "type": "object"
      },
      "type": "array"
    },
    "created": {
      "format": "date",
      "type": "string"
    },
    "horizon": {
      "minLength": 1,
      "type": "string"
    },
    "id": {
      "pattern": "^[A-Z]+-\\d{3,4}(-\\d+)?$",
      "type": "string"
    },
    "non_goals": {
      "items": {
        "minLength": 1,
        "type": "string"
      },
      "type": "array"
    },
    "one_liner": {
      "minLength": 1,
      "type": "string"
    },
    "problem": {
      "minLength": 1,
      "type": "string"
    },
    "product": {
      "minLength": 1,
      "type": "string"
    },
    "revision": {
      "exclusiveMinimum": 0,
      "type": "integer"
    },
    "run": {
      "minLength": 1,
      "type": "string"
    },
    "schemaVersion": {
      "exclusiveMinimum": 0,
      "type": "integer"
    },
    "status": {
      "minLength": 1,
      "type": "string"
    },
    "success_metrics": {
      "items": {
        "additionalProperties": false,
        "properties": {
          "baseline": {
            "minLength": 1,
            "type": "string"
          },
          "id": {
            "minLength": 1,
            "type": "string"
          },
          "instrumentation": {
            "minLength": 1,
            "type": "string"
          },
          "statement": {
            "minLength": 1,
            "type": "string"
          },
          "target": {
            "minLength": 1,
            "type": "string"
          }
        },
        "required": [
          "id",
          "statement",
          "baseline",
          "target",
          "instrumentation"
        ],
        "type": "object"
      },
      "type": "array"
    },
    "target_users": {
      "items": {
        "minLength": 1,
        "type": "string"
      },
      "type": "array"
    },
    "title": {
      "minLength": 1,
      "type": "string"
    },
    "type": {
      "const": "Vision",
      "type": "string"
    },
    "updated": {
      "format": "date",
      "type": "string"
    },
    "value_hypothesis": {
      "minLength": 1,
      "type": "string"
    }
  },
  "required": [
    "id",
    "type",
    "schemaVersion",
    "title",
    "status",
    "created",
    "updated",
    "revision",
    "author",
    "changelog",
    "product",
    "one_liner",
    "problem",
    "target_users",
    "value_hypothesis",
    "success_metrics",
    "non_goals",
    "horizon"
  ],
  "type": "object"
}
