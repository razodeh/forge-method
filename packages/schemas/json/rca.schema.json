{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "additionalProperties": false,
  "properties": {
    "author": {
      "minLength": 1,
      "type": "string"
    },
    "blast_radius": {
      "items": {
        "minLength": 1,
        "type": "string"
      },
      "type": "array"
    },
    "causal_chain": {
      "items": {
        "minLength": 1,
        "type": "string"
      },
      "type": "array"
    },
    "changelog": {
      "items": {
        "additionalProperties": false,
        "properties": {
          "by": {
            "minLength": 1,
            "type": "string"
          },
          "date": {
            "format": "date",
            "type": "string"
          },
          "revision": {
            "exclusiveMinimum": 0,
            "type": "integer"
          },
          "summary": {
            "minLength": 1,
            "type": "string"
          }
        },
        "required": [
          "revision",
          "date",
          "by",
          "summary"
        ],
        "type": "object"
      },
      "type": "array"
    },
    "created": {
      "format": "date",
      "type": "string"
    },
    "defect": {
      "minLength": 1,
      "type": "string"
    },
    "fix": {
      "minLength": 1,
      "type": "string"
    },
    "hypotheses": {
      "items": {
        "additionalProperties": false,
        "properties": {
          "claim": {
            "minLength": 1,
            "type": "string"
          },
          "refuted_by": {
            "anyOf": [
              {
                "minLength": 1,
                "type": "string"
              },
              {
                "type": "null"
              }
            ]
          },
          "status": {
            "enum": [
              "confirmed",
              "refuted"
            ],
            "type": "string"
          }
        },
        "required": [
          "claim",
          "refuted_by",
          "status"
        ],
        "type": "object"
      },
      "type": "array"
    },
    "id": {
      "pattern": "^[A-Z]+-\\d{3,4}(-\\d+)?$",
      "type": "string"
    },
    "kb_writes": {
      "items": {
        "minLength": 1,
        "type": "string"
      },
      "type": "array"
    },
    "prevention": {
      "items": {
        "minLength": 1,
        "type": "string"
      },
      "type": "array"
    },
    "reproduction": {
      "minLength": 1,
      "type": "string"
    },
    "revision": {
      "exclusiveMinimum": 0,
      "type": "integer"
    },
    "root_cause": {
      "minLength": 1,
      "type": "string"
    },
    "run": {
      "minLength": 1,
      "type": "string"
    },
    "schemaVersion": {
      "exclusiveMinimum": 0,
      "type": "integer"
    },
    "severity": {
      "enum": [
        "Sev1",
        "Sev2",
        "Sev3",
        "Sev4"
      ],
      "type": "string"
    },
    "status": {
      "minLength": 1,
      "type": "string"
    },
    "symptom": {
      "minLength": 1,
      "type": "string"
    },
    "time_to_diagnose_min": {
      "minimum": 0,
      "type": "number"
    },
    "timeline": {
      "items": {
        "additionalProperties": {
          "type": "string"
        },
        "type": "object"
      },
      "type": "array"
    },
    "title": {
      "minLength": 1,
      "type": "string"
    },
    "type": {
      "const": "RCA",
      "type": "string"
    },
    "updated": {
      "format": "date",
      "type": "string"
    }
  },
  "required": [
    "id",
    "type",
    "schemaVersion",
    "title",
    "status",
    "created",
    "updated",
    "revision",
    "author",
    "changelog",
    "defect",
    "severity",
    "symptom",
    "reproduction",
    "timeline",
    "hypotheses",
    "root_cause",
    "causal_chain",
    "fix",
    "prevention",
    "blast_radius",
    "kb_writes",
    "time_to_diagnose_min"
  ],
  "type": "object"
}
