{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "additionalProperties": false,
  "properties": {
    "author": {
      "minLength": 1,
      "type": "string"
    },
    "changelog": {
      "items": {
        "additionalProperties": false,
        "properties": {
          "by": {
            "minLength": 1,
            "type": "string"
          },
          "date": {
            "format": "date",
            "type": "string"
          },
          "revision": {
            "exclusiveMinimum": 0,
            "type": "integer"
          },
          "summary": {
            "minLength": 1,
            "type": "string"
          }
        },
        "required": [
          "revision",
          "date",
          "by",
          "summary"
        ],
        "type": "object"
      },
      "type": "array"
    },
    "created": {
      "format": "date",
      "type": "string"
    },
    "declarations": {
      "items": {
        "additionalProperties": false,
        "properties": {
          "captureDigest": {
            "pattern": "^[0-9a-f]{64}$",
            "type": "string"
          },
          "cases": {
            "items": {
              "additionalProperties": false,
              "properties": {
                "caseIndex": {
                  "minimum": 0,
                  "type": "integer"
                },
                "contentHash": {
                  "pattern": "^[0-9a-f]{64}$",
                  "type": "string"
                },
                "surface": {
                  "enum": [
                    "process",
                    "file",
                    "library",
                    "http"
                  ],
                  "type": "string"
                },
                "verdict": {
                  "enum": [
                    "error",
                    "unclean",
                    "unstable",
                    "mismatch",
                    "match"
                  ],
                  "type": "string"
                }
              },
              "required": [
                "surface",
                "caseIndex",
                "verdict"
              ],
              "type": "object"
            },
            "type": "array"
          },
          "digest": {
            "pattern": "^[0-9a-f]{64}$",
            "type": "string"
          },
          "exemptCount": {
            "maximum": 4,
            "minimum": 0,
            "type": "integer"
          },
          "name": {
            "minLength": 1,
            "type": "string"
          },
          "platform": {
            "pattern": "^[a-z0-9]+-[a-z0-9]+$",
            "type": "string"
          },
          "reason": {
            "minLength": 1,
            "type": "string"
          },
          "reference": {
            "additionalProperties": false,
            "properties": {
              "ref": {
                "minLength": 1,
                "type": "string"
              },
              "sha": {
                "pattern": "^(?:[0-9a-f]{40}|[0-9a-f]{64})$",
                "type": "string"
              }
            },
            "required": [
              "ref",
              "sha"
            ],
            "type": "object"
          },
          "verdict": {
            "enum": [
              "invalid",
              "expired",
              "missing",
              "ambiguous",
              "error",
              "unclean",
              "unstable",
              "mismatch",
              "match"
            ],
            "type": "string"
          }
        },
        "required": [
          "name",
          "digest",
          "reference",
          "platform",
          "captureDigest",
          "verdict",
          "cases",
          "exemptCount"
        ],
        "type": "object"
      },
      "type": "array"
    },
    "deltaDigest": {
      "pattern": "^[0-9a-f]{64}$",
      "type": "string"
    },
    "dirty": {
      "type": "boolean"
    },
    "headSha": {
      "pattern": "^(?:[0-9a-f]{40}|[0-9a-f]{64})$",
      "type": "string"
    },
    "id": {
      "pattern": "^[A-Z]+-\\d{3,4}(-\\d+)?$",
      "type": "string"
    },
    "reason": {
      "minLength": 1,
      "type": "string"
    },
    "revision": {
      "exclusiveMinimum": 0,
      "type": "integer"
    },
    "run": {
      "minLength": 1,
      "type": "string"
    },
    "schemaVersion": {
      "exclusiveMinimum": 0,
      "type": "integer"
    },
    "status": {
      "minLength": 1,
      "type": "string"
    },
    "story": {
      "minLength": 1,
      "type": "string"
    },
    "title": {
      "minLength": 1,
      "type": "string"
    },
    "toolVersions": {
      "additionalProperties": {
        "type": "string"
      },
      "type": "object"
    },
    "trusted": {
      "anyOf": [
        {
          "pattern": "^(?:[0-9a-f]{40}|[0-9a-f]{64})$",
          "type": "string"
        },
        {
          "type": "null"
        }
      ]
    },
    "type": {
      "const": "ParityEvidence",
      "type": "string"
    },
    "updated": {
      "format": "date",
      "type": "string"
    },
    "verdict": {
      "enum": [
        "invalid",
        "expired",
        "missing",
        "ambiguous",
        "error",
        "unclean",
        "unstable",
        "mismatch",
        "match"
      ],
      "type": "string"
    }
  },
  "required": [
    "id",
    "type",
    "schemaVersion",
    "title",
    "status",
    "created",
    "updated",
    "revision",
    "author",
    "changelog",
    "trusted",
    "headSha",
    "dirty",
    "deltaDigest",
    "toolVersions",
    "verdict",
    "declarations"
  ],
  "type": "object"
}
