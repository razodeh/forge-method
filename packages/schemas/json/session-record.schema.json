{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "additionalProperties": false,
  "properties": {
    "author": {
      "minLength": 1,
      "type": "string"
    },
    "changelog": {
      "items": {
        "additionalProperties": false,
        "properties": {
          "by": {
            "minLength": 1,
            "type": "string"
          },
          "date": {
            "format": "date",
            "type": "string"
          },
          "revision": {
            "exclusiveMinimum": 0,
            "type": "integer"
          },
          "summary": {
            "minLength": 1,
            "type": "string"
          }
        },
        "required": [
          "revision",
          "date",
          "by",
          "summary"
        ],
        "type": "object"
      },
      "type": "array"
    },
    "constraints_applied": {
      "items": {
        "minLength": 1,
        "type": "string"
      },
      "type": "array"
    },
    "cost_usd": {
      "minimum": 0,
      "type": "number"
    },
    "created": {
      "format": "date",
      "type": "string"
    },
    "ended": {
      "format": "date-time",
      "type": "string"
    },
    "id": {
      "pattern": "^[A-Z]+-\\d{3,4}(-\\d+)?$",
      "type": "string"
    },
    "no_disagreement_observed": {
      "type": "boolean"
    },
    "participants": {
      "items": {
        "minLength": 1,
        "type": "string"
      },
      "type": "array"
    },
    "question": {
      "minLength": 1,
      "type": "string"
    },
    "revision": {
      "exclusiveMinimum": 0,
      "type": "integer"
    },
    "run": {
      "minLength": 1,
      "type": "string"
    },
    "schemaVersion": {
      "exclusiveMinimum": 0,
      "type": "integer"
    },
    "sessionType": {
      "enum": [
        "brainstorm",
        "design-review",
        "tradeoff",
        "premortem",
        "retro",
        "war-room",
        "estimation",
        "standup",
        "discovery-interview",
        "story-refinement"
      ],
      "type": "string"
    },
    "started": {
      "format": "date-time",
      "type": "string"
    },
    "status": {
      "minLength": 1,
      "type": "string"
    },
    "technique": {
      "items": {
        "minLength": 1,
        "type": "string"
      },
      "type": "array"
    },
    "title": {
      "minLength": 1,
      "type": "string"
    },
    "type": {
      "const": "SessionRecord",
      "type": "string"
    },
    "updated": {
      "format": "date",
      "type": "string"
    }
  },
  "required": [
    "id",
    "type",
    "schemaVersion",
    "title",
    "status",
    "created",
    "updated",
    "revision",
    "author",
    "changelog",
    "sessionType",
    "technique",
    "question",
    "constraints_applied",
    "participants",
    "started",
    "ended",
    "cost_usd"
  ],
  "type": "object"
}
