{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "additionalProperties": false,
  "properties": {
    "affected": {
      "items": {
        "minLength": 1,
        "type": "string"
      },
      "type": "array"
    },
    "author": {
      "minLength": 1,
      "type": "string"
    },
    "changelog": {
      "items": {
        "additionalProperties": false,
        "properties": {
          "by": {
            "minLength": 1,
            "type": "string"
          },
          "date": {
            "format": "date",
            "type": "string"
          },
          "revision": {
            "exclusiveMinimum": 0,
            "type": "integer"
          },
          "summary": {
            "minLength": 1,
            "type": "string"
          }
        },
        "required": [
          "revision",
          "date",
          "by",
          "summary"
        ],
        "type": "object"
      },
      "type": "array"
    },
    "created": {
      "format": "date",
      "type": "string"
    },
    "environment": {
      "minLength": 1,
      "type": "string"
    },
    "evidence": {
      "items": {
        "minLength": 1,
        "type": "string"
      },
      "type": "array"
    },
    "expected": {
      "minLength": 1,
      "type": "string"
    },
    "first_seen": {
      "format": "date",
      "type": "string"
    },
    "frequency": {
      "minLength": 1,
      "type": "string"
    },
    "id": {
      "pattern": "^[A-Z]+-\\d{3,4}(-\\d+)?$",
      "type": "string"
    },
    "observed": {
      "minLength": 1,
      "type": "string"
    },
    "revision": {
      "exclusiveMinimum": 0,
      "type": "integer"
    },
    "run": {
      "minLength": 1,
      "type": "string"
    },
    "schemaVersion": {
      "exclusiveMinimum": 0,
      "type": "integer"
    },
    "severity": {
      "enum": [
        "Sev1",
        "Sev2",
        "Sev3",
        "Sev4"
      ],
      "type": "string"
    },
    "status": {
      "minLength": 1,
      "type": "string"
    },
    "title": {
      "minLength": 1,
      "type": "string"
    },
    "type": {
      "const": "Defect",
      "type": "string"
    },
    "updated": {
      "format": "date",
      "type": "string"
    }
  },
  "required": [
    "id",
    "type",
    "schemaVersion",
    "title",
    "status",
    "created",
    "updated",
    "revision",
    "author",
    "changelog",
    "observed",
    "expected",
    "first_seen",
    "frequency",
    "environment",
    "severity",
    "affected",
    "evidence"
  ],
  "type": "object"
}
