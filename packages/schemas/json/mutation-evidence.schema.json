{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "additionalProperties": false,
  "properties": {
    "author": {
      "minLength": 1,
      "type": "string"
    },
    "changelog": {
      "items": {
        "additionalProperties": false,
        "properties": {
          "by": {
            "minLength": 1,
            "type": "string"
          },
          "date": {
            "format": "date",
            "type": "string"
          },
          "revision": {
            "exclusiveMinimum": 0,
            "type": "integer"
          },
          "summary": {
            "minLength": 1,
            "type": "string"
          }
        },
        "required": [
          "revision",
          "date",
          "by",
          "summary"
        ],
        "type": "object"
      },
      "type": "array"
    },
    "created": {
      "format": "date",
      "type": "string"
    },
    "failedUnderMutation": {
      "items": {
        "minLength": 1,
        "type": "string"
      },
      "type": "array"
    },
    "hunkRun": {
      "additionalProperties": false,
      "properties": {
        "baseSha": {
          "pattern": "^[0-9a-f]{40}$",
          "type": "string"
        },
        "diffAlgorithm": {
          "minLength": 1,
          "type": "string"
        },
        "granularity": {
          "enum": [
            "hunk",
            "file",
            "change"
          ],
          "type": "string"
        },
        "hunks": {
          "items": {
            "additionalProperties": false,
            "properties": {
              "contentHash": {
                "pattern": "^[0-9a-f]{64}$",
                "type": "string"
              },
              "id": {
                "minLength": 1,
                "type": "string"
              },
              "killedBy": {
                "minLength": 1,
                "type": "string"
              },
              "path": {
                "minLength": 1,
                "type": "string"
              },
              "ranges": {
                "additionalProperties": false,
                "properties": {
                  "new": {
                    "$ref": "#/properties/hunkRun/properties/hunks/items/properties/ranges/properties/old"
                  },
                  "old": {
                    "additionalProperties": false,
                    "properties": {
                      "length": {
                        "minimum": 0,
                        "type": "integer"
                      },
                      "start": {
                        "minimum": 0,
                        "type": "integer"
                      }
                    },
                    "required": [
                      "start",
                      "length"
                    ],
                    "type": "object"
                  }
                },
                "required": [
                  "old",
                  "new"
                ],
                "type": "object"
              },
              "verdict": {
                "enum": [
                  "killed",
                  "uncovered",
                  "invalid",
                  "timeout",
                  "skipped"
                ],
                "type": "string"
              }
            },
            "required": [
              "id",
              "path",
              "ranges",
              "contentHash",
              "verdict"
            ],
            "type": "object"
          },
          "type": "array"
        }
      },
      "required": [
        "baseSha",
        "diffAlgorithm",
        "granularity",
        "hunks"
      ],
      "type": "object"
    },
    "id": {
      "pattern": "^[A-Z]+-\\d{3,4}(-\\d+)?$",
      "type": "string"
    },
    "mutationKind": {
      "enum": [
        "revert-implementation",
        "revert-hunks"
      ],
      "type": "string"
    },
    "namedTests": {
      "items": {
        "minLength": 1,
        "type": "string"
      },
      "minItems": 1,
      "type": "array"
    },
    "ranAt": {
      "format": "date-time",
      "type": "string"
    },
    "restoreVerified": {
      "type": "boolean"
    },
    "revertedRange": {
      "additionalProperties": false,
      "properties": {
        "fromSha": {
          "pattern": "^[0-9a-f]{40}$",
          "type": "string"
        },
        "toSha": {
          "pattern": "^[0-9a-f]{40}$",
          "type": "string"
        }
      },
      "required": [
        "fromSha",
        "toSha"
      ],
      "type": "object"
    },
    "revision": {
      "exclusiveMinimum": 0,
      "type": "integer"
    },
    "run": {
      "minLength": 1,
      "type": "string"
    },
    "schemaVersion": {
      "exclusiveMinimum": 0,
      "type": "integer"
    },
    "status": {
      "minLength": 1,
      "type": "string"
    },
    "story": {
      "minLength": 1,
      "type": "string"
    },
    "title": {
      "minLength": 1,
      "type": "string"
    },
    "toolVersions": {
      "additionalProperties": {
        "type": "string"
      },
      "type": "object"
    },
    "type": {
      "const": "MutationEvidence",
      "type": "string"
    },
    "updated": {
      "format": "date",
      "type": "string"
    }
  },
  "required": [
    "id",
    "type",
    "schemaVersion",
    "title",
    "status",
    "created",
    "updated",
    "revision",
    "author",
    "changelog",
    "story",
    "mutationKind",
    "revertedRange",
    "namedTests",
    "failedUnderMutation",
    "restoreVerified",
    "toolVersions",
    "ranAt"
  ],
  "type": "object"
}
