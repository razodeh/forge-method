{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "additionalProperties": false,
  "properties": {
    "alt_text": {
      "minLength": 1,
      "type": "string"
    },
    "author": {
      "minLength": 1,
      "type": "string"
    },
    "caption": {
      "minLength": 1,
      "type": "string"
    },
    "changelog": {
      "items": {
        "additionalProperties": false,
        "properties": {
          "by": {
            "minLength": 1,
            "type": "string"
          },
          "date": {
            "format": "date",
            "type": "string"
          },
          "revision": {
            "exclusiveMinimum": 0,
            "type": "integer"
          },
          "summary": {
            "minLength": 1,
            "type": "string"
          }
        },
        "required": [
          "revision",
          "date",
          "by",
          "summary"
        ],
        "type": "object"
      },
      "type": "array"
    },
    "created": {
      "format": "date",
      "type": "string"
    },
    "depicts": {
      "items": {
        "minLength": 1,
        "type": "string"
      },
      "type": "array"
    },
    "explains": {
      "items": {
        "minLength": 1,
        "type": "string"
      },
      "type": "array"
    },
    "generated": {
      "type": "boolean"
    },
    "generator": {
      "minLength": 1,
      "type": "string"
    },
    "id": {
      "pattern": "^[A-Z]+-\\d{3,4}(-\\d+)?$",
      "type": "string"
    },
    "kind": {
      "minLength": 1,
      "type": "string"
    },
    "notation": {
      "enum": [
        "mermaid",
        "plantuml",
        "d2",
        "dot",
        "structurizr"
      ],
      "type": "string"
    },
    "owner": {
      "minLength": 1,
      "type": "string"
    },
    "review_by": {
      "format": "date",
      "type": "string"
    },
    "revision": {
      "exclusiveMinimum": 0,
      "type": "integer"
    },
    "run": {
      "minLength": 1,
      "type": "string"
    },
    "schemaVersion": {
      "exclusiveMinimum": 0,
      "type": "integer"
    },
    "source": {
      "minLength": 1,
      "type": "string"
    },
    "status": {
      "minLength": 1,
      "type": "string"
    },
    "title": {
      "minLength": 1,
      "type": "string"
    },
    "type": {
      "const": "Diagram",
      "type": "string"
    },
    "updated": {
      "format": "date",
      "type": "string"
    },
    "verified": {
      "format": "date",
      "type": "string"
    }
  },
  "required": [
    "id",
    "type",
    "schemaVersion",
    "title",
    "status",
    "created",
    "updated",
    "revision",
    "author",
    "changelog",
    "kind",
    "notation",
    "source",
    "generated",
    "depicts",
    "explains",
    "caption",
    "alt_text",
    "owner"
  ],
  "type": "object"
}
