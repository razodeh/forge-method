{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "additionalProperties": false,
  "properties": {
    "forgeTestReport": {
      "const": 1,
      "type": "number"
    },
    "tests": {
      "items": {
        "additionalProperties": false,
        "properties": {
          "acId": {
            "minLength": 1,
            "type": "string"
          },
          "durationMs": {
            "minimum": 0,
            "type": "number"
          },
          "file": {
            "minLength": 1,
            "type": "string"
          },
          "kind": {
            "enum": [
              "assertion",
              "load",
              "timeout",
              "crash"
            ],
            "type": "string"
          },
          "name": {
            "minLength": 1,
            "type": "string"
          },
          "status": {
            "enum": [
              "pass",
              "fail",
              "skip"
            ],
            "type": "string"
          }
        },
        "required": [
          "name",
          "status"
        ],
        "type": "object"
      },
      "type": "array"
    }
  },
  "required": [
    "forgeTestReport",
    "tests"
  ],
  "type": "object"
}
