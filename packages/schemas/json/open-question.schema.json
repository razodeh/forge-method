{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "additionalProperties": false,
  "properties": {
    "id": {
      "pattern": "^OQ-\\d{3}(-\\d+)?$",
      "type": "string"
    },
    "question": {
      "minLength": 1,
      "type": "string"
    },
    "sources": {
      "items": {
        "additionalProperties": false,
        "properties": {
          "kind": {
            "enum": [
              "decision",
              "human",
              "code"
            ],
            "type": "string"
          },
          "ref": {
            "minLength": 1,
            "type": "string"
          }
        },
        "required": [
          "kind",
          "ref"
        ],
        "type": "object"
      },
      "type": "array"
    },
    "status": {
      "enum": [
        "open",
        "resolved"
      ],
      "type": "string"
    }
  },
  "required": [
    "id",
    "question",
    "status"
  ],
  "type": "object"
}
