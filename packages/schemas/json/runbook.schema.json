{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "additionalProperties": false,
  "properties": {
    "author": {
      "minLength": 1,
      "type": "string"
    },
    "changelog": {
      "items": {
        "additionalProperties": false,
        "properties": {
          "by": {
            "minLength": 1,
            "type": "string"
          },
          "date": {
            "format": "date",
            "type": "string"
          },
          "revision": {
            "exclusiveMinimum": 0,
            "type": "integer"
          },
          "summary": {
            "minLength": 1,
            "type": "string"
          }
        },
        "required": [
          "revision",
          "date",
          "by",
          "summary"
        ],
        "type": "object"
      },
      "type": "array"
    },
    "created": {
      "format": "date",
      "type": "string"
    },
    "diagnosis_steps": {
      "items": {
        "minLength": 1,
        "type": "string"
      },
      "type": "array"
    },
    "escalation": {
      "minLength": 1,
      "type": "string"
    },
    "id": {
      "pattern": "^[A-Z]+-\\d{3,4}(-\\d+)?$",
      "type": "string"
    },
    "immediate_mitigation": {
      "minLength": 1,
      "type": "string"
    },
    "post_incident_actions": {
      "items": {
        "minLength": 1,
        "type": "string"
      },
      "type": "array"
    },
    "revision": {
      "exclusiveMinimum": 0,
      "type": "integer"
    },
    "run": {
      "minLength": 1,
      "type": "string"
    },
    "schemaVersion": {
      "exclusiveMinimum": 0,
      "type": "integer"
    },
    "sources": {
      "items": {
        "additionalProperties": false,
        "properties": {
          "kind": {
            "enum": [
              "decision",
              "human",
              "code"
            ],
            "type": "string"
          },
          "ref": {
            "minLength": 1,
            "type": "string"
          }
        },
        "required": [
          "kind",
          "ref"
        ],
        "type": "object"
      },
      "type": "array"
    },
    "status": {
      "minLength": 1,
      "type": "string"
    },
    "symptoms": {
      "minLength": 1,
      "type": "string"
    },
    "title": {
      "minLength": 1,
      "type": "string"
    },
    "type": {
      "const": "Runbook",
      "type": "string"
    },
    "updated": {
      "format": "date",
      "type": "string"
    }
  },
  "required": [
    "id",
    "type",
    "schemaVersion",
    "title",
    "status",
    "created",
    "updated",
    "revision",
    "author",
    "changelog",
    "symptoms",
    "immediate_mitigation",
    "diagnosis_steps",
    "escalation",
    "post_incident_actions"
  ],
  "type": "object"
}
