{
  "name": "forge-monorepo",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "packageManager": "pnpm@9.15.5",
  "engines": {
    "node": ">=20.19"
  },
  "scripts": {
    "build": "turbo run build",
    "typecheck": "tsc --noEmit -p tsconfig.json && turbo run typecheck",
    "lint": "eslint . --max-warnings 0 && prettier --check .",
    "format": "prettier --write .",
    "test": "node scripts/run-tests.mjs run --coverage && node scripts/check-coverage-ratchet.mjs && node scripts/run-tests.mjs run --config vitest.boundaries-coverage.config.ts --coverage",
    "coverage:boundaries": "node scripts/run-tests.mjs run --config vitest.boundaries-coverage.config.ts --coverage",
    "test:watch": "node scripts/run-tests.mjs",
    "boundaries": "node scripts/check-boundaries.mjs",
    "changeset": "changeset",
    "coverage:ratchet": "node scripts/check-coverage-ratchet.mjs",
    "emit-schemas": "node scripts/emit-schemas.mjs",
    "schema-drift": "node scripts/assert-schema-drift.mjs"
  },
  "devDependencies": {
    "@changesets/cli": "2.31.1",
    "@eslint/js": "9.39.5",
    "@types/estree": "1.0.9",
    "@types/node": "20.19.35",
    "@typescript-eslint/parser": "8.69.0",
    "@vitest/coverage-v8": "4.1.11",
    "eslint": "9.39.5",
    "eslint-config-prettier": "10.1.8",
    "prettier": "3.9.6",
    "tsup": "8.5.1",
    "turbo": "2.10.12",
    "typescript": "5.9.3",
    "typescript-eslint": "8.69.0",
    "vitest": "4.1.11"
  }
}
